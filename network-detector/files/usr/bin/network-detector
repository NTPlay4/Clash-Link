#!/bin/sh
#
# OpenWrt 网络检测脚本 - 支持多任务、Clash代理切换、Webhooks通知
# 读取 UCI 配置: /etc/config/network-detector
#

LOG_FILE="/var/log/network-detector.log"
COUNTER_FILE="/var/lib/network-detector/counters"

# 本次运行的临时文件（进程退出时由 trap 清理）
API_TMP="/tmp/network-detector.api.$$"
TEST_TMP="/tmp/network-detector.test.$$"
CAND_FILE="/tmp/network-detector.cand.$$"

# =============================================================
# 从 UCI 读取全局配置
# =============================================================
load_global_config() {
    CLASH_API="$(uci -q get network-detector.@clash[0].api_url 2>/dev/null)"
    CLASH_SECRET="$(uci -q get network-detector.@clash[0].secret 2>/dev/null)"
    LOCAL_PROXY="$(uci -q get network-detector.@clash[0].local_proxy 2>/dev/null)"
    PROXY_TYPE="$(uci -q get network-detector.@clash[0].proxy_type 2>/dev/null)"
    LOG_RETENTION="$(uci -q get network-detector.@main[0].log_retention_days 2>/dev/null)"

    : ${CLASH_API:="http://127.0.0.1:9090"}
    : ${LOCAL_PROXY:="127.0.0.1:7890"}
    : ${PROXY_TYPE:="http"}
    : ${LOG_RETENTION:="3"}
    # 去掉末尾斜杠，避免拼出 //proxies
    CLASH_API="${CLASH_API%/}"

    # 自动检测 OpenClash Secret (运行时补救)
    if [ -z "$CLASH_SECRET" ]; then
        # 1) 尝试从 OpenClash UCI 读取
        CLASH_SECRET=$(uci -q get openclash.@config[0].dashboard_password 2>/dev/null)

        # 2) uci show 兜底（某些版本 key 名不同）
        if [ -z "$CLASH_SECRET" ]; then
            CLASH_SECRET=$(uci -q show openclash 2>/dev/null | grep -iE '(password|secret|token)' | head -1 | sed "s/^[^=]*='*//;s/'$//")
        fi

        # 3) YAML 配置（去掉 ^ 锚点，兼容缩进；同时搜 .yaml .yml；多目录）
        if [ -z "$CLASH_SECRET" ]; then
            for dir in /etc/openclash/config /etc/openclash/custom /etc/openclash; do
                [ -d "$dir" ] || continue
                for conf in "$dir"/*.yaml "$dir"/*.yml; do
                    [ -f "$conf" ] || continue
                    CLASH_SECRET=$(grep -hm1 'secret:' "$conf" 2>/dev/null | sed "s/.*secret:[[:space:]]*['\"]\?//;s/['\"].*$//;s/[[:space:]]*$//" | head -1)
                    [ -n "$CLASH_SECRET" ] && break 2
                done
            done
        fi
    fi

    # 构造 curl -x 用的代理地址
    case "$PROXY_TYPE" in
        socks5) CURL_PROXY="socks5://${LOCAL_PROXY}" ;;
        http|*)  CURL_PROXY="${LOCAL_PROXY}" ;;
    esac

    # Webhook 配置（两个独立开关）
    WEBHOOK_NOTIFY_RECOVER="$(uci -q get network-detector.@webhook[0].notify_recover 2>/dev/null)"
    WEBHOOK_NOTIFY_ALLFAIL="$(uci -q get network-detector.@webhook[0].notify_allfail 2>/dev/null)"
    WEBHOOK_URL="$(uci -q get network-detector.@webhook[0].url 2>/dev/null)"
}

# =============================================================
# 检测 banned_keyword: 为空时完全跳过关键词检查
# 若意外传入纯数字（如旧版 Tab 合并残留的 max_tries）也视为无关键词
# =============================================================
is_nonempty_keyword() {
    local kw="$1"
    [ -z "$kw" ] && return 1
    # 纯数字不视为关键词
    case "$kw" in
        ''|*[!0-9]*) return 0 ;;
        *) return 1 ;;
    esac
}

# 转义字符串中 jsonfilter 表达式里的特殊字符 (双引号 / 反斜杠)
json_escape() {
    echo "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# =============================================================
# URL 编码（按字节 %XX 全量编码，兼容策略组名中的 emoji / 中文 / 空格）
# 旧实现只把空格换成 %20，中文和 emoji 直接塞进 URL，PUT 请求常被 API 拒绝，
# 表现为「一直切换但节点没变」。
# =============================================================
url_encode() {
    local hex
    hex=$(printf '%s' "$1" | od -An -tx1 -v 2>/dev/null | tr -d ' \n')
    case "$hex" in
        ''|*[!0-9a-fA-F]*)
            # 极简固件可能没有 od，用 awk 逐字节转十六进制
            hex=$(printf '%s' "$1" | LC_ALL=C awk '
                BEGIN { for (i = 0; i < 256; i++) ord[sprintf("%c", i)] = i }
                { for (i = 1; i <= length($0); i++) printf "%02x", ord[substr($0, i, 1)] }' 2>/dev/null)
            ;;
    esac
    case "$hex" in
        ''|*[!0-9a-fA-F]*)
            # 最后兜底：只编码空格和常见特殊字符，UTF-8 字节原样保留
            printf '%s' "$1" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/"/%22/g' \
                -e 's/#/%23/g' -e 's/?/%3F/g' -e 's/&/%26/g' -e 's/+/%2B/g' -e "s/'/%27/g"
            ;;
        *) printf '%s' "$hex" | sed 's/../%&/g' ;;
    esac
}

# 亚秒级休眠（busybox 支持小数秒时用小数，否则退回 1 秒）
small_sleep() {
    sleep 0.3 2>/dev/null || sleep 1
}

# =============================================================
# Clash API 请求封装
#   api_call <METHOD> <PATH> [JSON_BODY]
# 响应体写入 $API_TMP，状态码写入 $API_CODE
# 返回 0 表示 HTTP 2xx
# =============================================================
api_call() {
    local method="$1"
    local path="$2"
    local body="$3"
    local code

    if [ -n "$body" ]; then
        code=$(curl -s -o "$API_TMP" -w '%{http_code}' -X "$method" \
            --connect-timeout 5 --max-time 10 \
            -H "Authorization: Bearer ${CLASH_SECRET}" \
            -H "Content-Type: application/json" \
            --data-binary "$body" \
            "${CLASH_API}${path}" 2>/dev/null)
    else
        code=$(curl -s -o "$API_TMP" -w '%{http_code}' -X "$method" \
            --connect-timeout 5 --max-time 10 \
            -H "Authorization: Bearer ${CLASH_SECRET}" \
            "${CLASH_API}${path}" 2>/dev/null)
    fi

    API_CURL_ERR=$?
    API_CODE="$code"
    case "$code" in
        2*) return 0 ;;
        *)  return 1 ;;
    esac
}

# =============================================================
# Webhook 通知函数（通用，支持 Bark/企微/钉钉等 GET 类 Webhook）
# =============================================================
send_webhook_notification() {
    local type="$1"   # "recover" 或 "allfail"
    local title="$2"
    local body="$3"

    # 根据通知类型检查对应的开关
    case "$type" in
        recover)
            [ "$WEBHOOK_NOTIFY_RECOVER" != "1" ] && return 0
            ;;
        allfail)
            [ "$WEBHOOK_NOTIFY_ALLFAIL" != "1" ] && return 0
            ;;
        *)
            return 0
            ;;
    esac

    if [ -z "$WEBHOOK_URL" ]; then
        return 0
    fi
    # URL 编码 title 和 body（只编码空格，curl --data-urlencode 在 busybox 不可用）
    local enc_title=$(echo -n "$title" | sed 's/ /%20/g; s/!/%21/g; s/#/%23/g; s/\$/%24/g; s/&/%26/g; s/'\''/%27/g; s/(/%28/g; s/)/%29/g; s/\*/%2A/g; s/+/%2B/g; s/,/%2C/g; s/\//%2F/g; s/:/%3A/g; s/;/%3B/g; s/=/%3D/g; s/?!/%3F/g; s/@/%40/g; s/\[/%5B/g; s/\]/%5D/g')
    local enc_body=$(echo -n "$body" | sed 's/ /%20/g; s/!/%21/g; s/#/%23/g; s/\$/%24/g; s/&/%26/g; s/'\''/%27/g; s/(/%28/g; s/)/%29/g; s/\*/%2A/g; s/+/%2B/g; s/,/%2C/g; s/\//%2F/g; s/:/%3A/g; s/;/%3B/g; s/=/%3D/g; s/?!/%3F/g; s/@/%40/g; s/\[/%5B/g; s/\]/%5D/g')
    curl -s --max-time 5 -X GET "${WEBHOOK_URL}/${enc_title}/${enc_body}" > /dev/null 2>&1
}

# =============================================================
# 日志清理：仅保留最近 N 天的日志
# =============================================================
cleanup_old_logs() {
    if [ -f "$LOG_FILE" ]; then
        local retention_seconds=$((LOG_RETENTION * 86400))
        local cutoff_ts=$(( $(date +%s) - retention_seconds ))
        local cutoff_date=$(date -d "@$cutoff_ts" "+%Y-%m-%d" 2>/dev/null)
        if [ -n "$cutoff_date" ]; then
            awk -v limit="$cutoff_date" '$1 >= limit && NF > 0' "$LOG_FILE" > "${LOG_FILE}.tmp" 2>/dev/null
            mv "${LOG_FILE}.tmp" "$LOG_FILE"
        fi
    fi
}

# =============================================================
# 日志函数
# =============================================================
log() {
    local msg="$1"
    local task_name="$2"
    local prefix=""
    [ -n "$task_name" ] && prefix="[$task_name] "
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${prefix}${msg}" | tee -a "$LOG_FILE"
}

# =============================================================
# 当日计数器：reconnect（切换后恢复成功）/ fail（次数耗尽全部失败）
# 文件格式: task_name|YYYY-MM-DD|reconnects|failures
# 跨天自动重置
# =============================================================
COUNTER_DIR=$(dirname "$COUNTER_FILE")
[ -d "$COUNTER_DIR" ] || mkdir -p "$COUNTER_DIR"

counter_increment() {
    local task_name="$1"
    local field="$2"   # "reconnect" or "fail"
    local today=$(date '+%Y-%m-%d')
    local tmp="${COUNTER_FILE}.tmp"

    local found=0
    {
        if [ -f "$COUNTER_FILE" ]; then
            while IFS='|' read -r name date rec fail rest; do
                if [ "$name" = "$task_name" ]; then
                    found=1
                    if [ "$date" != "$today" ]; then
                        # 跨天重置
                        if [ "$field" = "reconnect" ]; then
                            echo "${task_name}|${today}|1|0"
                        else
                            echo "${task_name}|${today}|0|1"
                        fi
                    else
                        if [ "$field" = "reconnect" ]; then
                            rec=$((rec + 1))
                        else
                            fail=$((fail + 1))
                        fi
                        echo "${task_name}|${today}|${rec}|${fail}"
                    fi
                else
                    # 保留其他任务行（也检查日期）
                    [ -n "$name" ] && echo "$name|$date|$rec|$fail"
                fi
            done < "$COUNTER_FILE"
        fi
        if [ "$found" = "0" ]; then
            if [ "$field" = "reconnect" ]; then
                echo "${task_name}|${today}|1|0"
            else
                echo "${task_name}|${today}|0|1"
            fi
        fi
    } > "$tmp"
    mv "$tmp" "$COUNTER_FILE"
}

# =============================================================
# 读取策略组状态 -> GROUP_TYPE / CURRENT_NODE / NODES
# 只取单个策略组，避免拉取整个 /proxies（路由上 jsonfilter 解析大 JSON 很慢）
# 返回: 0=成功 1=认证/连接错误 2=策略组不存在或不可选
# =============================================================
fetch_group_state() {
    # 优先使用旧版可用的路径形式（空格 %20、中文/emoji 原样），
    # 若部分 Clash 版本不接受，再尝试全字节 %XX 编码
    local path1="/proxies/$(printf '%s' "$PROXY_GROUP" | sed 's/ /%20/g')"
    local path2="/proxies/$(url_encode "$PROXY_GROUP")"

    if api_call GET "$path1"; then
        GROUP_PATH="$path1"
    elif [ "$API_CODE" = "401" ] || [ "$API_CODE" = "403" ]; then
        log "错误: Clash API 认证失败 (HTTP ${API_CODE})，请检查网页配置中的 API 密钥是否正确" "$TASK_NAME"
        return 1
    elif [ "$path2" != "$path1" ] && api_call GET "$path2"; then
        GROUP_PATH="$path2"
        log "提示: 策略组名需使用完整 URL 编码，已自动切换编码方式" "$TASK_NAME"
    else
        case "$API_CODE" in
            404)
                log "错误: 找不到策略组 [${PROXY_GROUP}]" "$TASK_NAME"
                return 2 ;;
            000|"")
                local hint=""
                case "$API_CURL_ERR" in
                    3)  hint="（curl 退出码 ${API_CURL_ERR}: URL 不合法）" ;;
                    7)  hint="（curl 退出码 ${API_CURL_ERR}: 连接被拒绝，请确认 Clash 正在运行）" ;;
                    23) hint="（curl 退出码 ${API_CURL_ERR}: 临时文件无法写入）" ;;
                    28) hint="（curl 退出码 ${API_CURL_ERR}: 请求超时）" ;;
                    *)  hint="（curl 退出码 ${API_CURL_ERR}）" ;;
                esac
                log "错误: 无法连接到 Clash API (${CLASH_API})${hint}" "$TASK_NAME"
                ;;
            *)
                log "错误: 读取策略组失败 (HTTP ${API_CODE}): $(tr -d '\n' < "$API_TMP" 2>/dev/null | cut -c1-100)" "$TASK_NAME"
                ;;
        esac
        return 1
    fi

    GROUP_TYPE=$(jsonfilter -e '@.type' < "$API_TMP" 2>/dev/null)
    CURRENT_NODE=$(jsonfilter -e '@.now' < "$API_TMP" 2>/dev/null)
    NODES=$(jsonfilter -e '@.all' < "$API_TMP" 2>/dev/null | grep -o '"[^"]*"' | sed 's/"//g')

    if [ -z "$CURRENT_NODE" ] || [ -z "$NODES" ]; then
        log "错误: 策略组 [${PROXY_GROUP}] 没有可选节点 (类型: ${GROUP_TYPE:-未知})" "$TASK_NAME"
        return 2
    fi
    return 0
}

# =============================================================
# 生成候选节点（写入 $CAND_FILE）
# 从当前节点之后环形遍历；跳过信息类节点与内置策略，避免切到“剩余流量”之类的假节点
# =============================================================
build_candidates() {
    local cur="$1"
    printf '%s\n' "$NODES" | awk -v cur="$cur" '
        NF { lines[++n] = $0 }
        END {
            start = 1
            for (i = 1; i <= n; i++) if (lines[i] == cur) { start = i + 1; break }
            for (k = 0; k < n; k++) {
                idx = start + k
                while (idx > n) idx -= n
                name = lines[idx]
                if (name == "" || name == cur) continue
                if (name ~ /^(DIRECT|REJECT|REJECT-DROP|PASS|COMPATIBLE|GLOBAL|PROXY)$/) continue
                if (name ~ /(剩余|流量|到期|过期|官网|套餐|订阅|续费|重置|客服|群组|邀请)/) continue
                print name
            }
        }' > "$CAND_FILE"
}

# =============================================================
# 切换节点并校验是否真正生效
# 返回: 0=已生效 1=请求失败 2=提交成功但当前节点未变（被 url-test/fallback 等自动选路覆盖）
# =============================================================
switch_node() {
    local target="$1"
    local path="${GROUP_PATH:-/proxies/$(url_encode "$PROXY_GROUP")}"
    local body="{\"name\":\"$(json_escape "$target")\"}"

    if ! api_call PUT "$path" "$body"; then
        log "切换请求失败 (HTTP ${API_CODE}, curl 退出码 ${API_CURL_ERR}): $(tr -d '\n' < "$API_TMP" 2>/dev/null | cut -c1-100)" "$TASK_NAME"
        return 1
    fi

    # 轮询确认是否真的切过去了（最多约 2 秒）
    local i=0 now=""
    while [ $i -lt 6 ]; do
        if api_call GET "$path"; then
            now=$(jsonfilter -e '@.now' < "$API_TMP" 2>/dev/null)
            if [ "$now" = "$target" ]; then
                CURRENT_NODE="$now"
                return 0
            fi
        fi
        i=$((i + 1))
        [ $i -lt 6 ] && small_sleep
    done

    [ -n "$now" ] && CURRENT_NODE="$now"
    return 2
}

# =============================================================
# 通过本地代理测试连通性
# 返回 0=正常 / 1=失败；TEST_DETAIL 为日志详情，TEST_REASON 为简短原因
# =============================================================
test_proxy() {
    local url="$1"
    local sep='?'
    case "$url" in *\?*) sep='&' ;; esac
    local probe="${url}${sep}_nd=$(date +%s)-$$"

    # 响应体落到文件，避免把整页 HTML 读进 shell 变量（大页面会拖慢/占用内存）
    TEST_CODE=$(curl -s -x "$CURL_PROXY" -L \
        --connect-timeout 5 --max-time 10 \
        -H "Cache-Control: no-cache" \
        -H "Pragma: no-cache" \
        -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36" \
        -o "$TEST_TMP" -w '%{http_code}' \
        "$probe" 2>/dev/null)
    local st=$?

    TEST_DETAIL=""
    TEST_REASON=""

    if [ "$st" -ne 0 ]; then
        TEST_REASON="无法连接"
        TEST_DETAIL="无法连接 (curl 退出码: ${st})"
        return 1
    fi
    if [ ! -s "$TEST_TMP" ]; then
        TEST_REASON="无法连接"
        TEST_DETAIL="无法连接 (响应为空, HTTP ${TEST_CODE})"
        return 1
    fi
    if is_nonempty_keyword "$BANNED_KEYWORD" && grep -qF -- "$BANNED_KEYWORD" "$TEST_TMP" 2>/dev/null; then
        TEST_REASON="被封"
        TEST_DETAIL="IP 已被封禁 (匹配关键词: ${BANNED_KEYWORD})"
        return 1
    fi
    return 0
}

# =============================================================
# 执行单个检测任务
# 流程: 先测当前节点 -> 生成候选 -> (切换 + 校验生效 + 立即复测) × N
# =============================================================
run_single_task() {
    local TASK_NAME="$1"
    local PROXY_GROUP="$2"
    local TEST_URL="$3"
    local BANNED_KEYWORD="$4"
    local MAX_TRIES="$5"

    # 参数校验
    [ -z "$TASK_NAME" ] && TASK_NAME="未命名任务"
    [ -z "$MAX_TRIES" ] && MAX_TRIES="5"
    case "$MAX_TRIES" in ''|*[!0-9]*) MAX_TRIES="5" ;; esac
    [ "$MAX_TRIES" -lt 1 ] && MAX_TRIES="1"
    [ "$MAX_TRIES" -gt 20 ] && MAX_TRIES="20"

    log "开始检测 [${TEST_URL}] ..." "$TASK_NAME"

    if ! fetch_group_state; then
        return 1
    fi

    log "策略组 [${PROXY_GROUP}] 当前节点: ${CURRENT_NODE}" "$TASK_NAME"

    # Clash Meta 的 Selector/URLTest/Fallback 均支持 PUT 指定节点，统一尝试切换并校验
    local prev_node="$CURRENT_NODE"
    local first_fail_reason=""
    local attempt=0

    # ---- 1. 先测当前节点 ----
    log "尝试访问 (第 1/${MAX_TRIES} 次)..." "$TASK_NAME"
    if test_proxy "$TEST_URL"; then
        log "访问正常，无需切换" "$TASK_NAME"
        return 0
    fi
    log "${TEST_DETAIL}" "$TASK_NAME"
    first_fail_reason="$TEST_REASON"
    log "当前节点 [${CURRENT_NODE}] 判定失效 (${TEST_REASON})" "$TASK_NAME"

    # ---- 2. 生成候选节点 ----
    build_candidates "$CURRENT_NODE"
    local total=$(grep -c . "$CAND_FILE" 2>/dev/null)
    case "$total" in ''|*[!0-9]*) total=0 ;; esac

    if [ "$total" -eq 0 ]; then
        log "策略组内没有其他可切换节点，无法切换" "$TASK_NAME"
        counter_increment "$TASK_NAME" "fail"
        send_webhook_notification "allfail" "${TASK_NAME} 全部失败" "策略组 [${PROXY_GROUP}] 无其他可用节点，起因: ${first_fail_reason}"
        return 1
    fi

    # ---- 3. 逐个切换 + 校验 + 立即复测 ----
    local i=1
    local target=""
    while [ $i -le "$total" ] && [ $attempt -lt "$MAX_TRIES" ]; do
        target=$(sed -n "${i}p" "$CAND_FILE")
        i=$((i + 1))
        [ -z "$target" ] && continue
        attempt=$((attempt + 1))

        log "切换到节点: ${target}" "$TASK_NAME"
        switch_node "$target"
        case $? in
            1)
                # 请求本身失败（HTTP 错误/网络错误），本次不计入有效复测
                continue ;;
            2)
                # URLTest 测速可能把节点改成了另一个：不跳过，改测 Clash 实际选中的节点
                log "切换未生效，当前被策略组改选为 [${CURRENT_NODE}]（目标: ${target}），改测当前节点" "$TASK_NAME"
                ;;
        esac

        log "尝试访问 (第 $((attempt + 1))/${MAX_TRIES} 次)..." "$TASK_NAME"
        if test_proxy "$TEST_URL"; then
            log "切换后访问恢复！[${prev_node}](${first_fail_reason}) → [${CURRENT_NODE}]" "$TASK_NAME"
            counter_increment "$TASK_NAME" "reconnect"
            send_webhook_notification "recover" \
                "${TASK_NAME} 已恢复" \
                "节点 [${prev_node}] ${first_fail_reason}，切换至 [${CURRENT_NODE}] 后访问正常"
            return 0
        fi

        log "${TEST_DETAIL}" "$TASK_NAME"
        prev_node="$CURRENT_NODE"
        log "当前节点 [${CURRENT_NODE}] 判定失效 (${TEST_REASON})" "$TASK_NAME"

        small_sleep
    done

    local reason_text="${first_fail_reason:-未知原因}"
    log "已依次切换 ${attempt} 个节点，全部失败 (起因: ${reason_text})" "$TASK_NAME"
    counter_increment "$TASK_NAME" "fail"
    send_webhook_notification "allfail" "${TASK_NAME} 全部失败" "已依次尝试切换 ${attempt} 个节点仍失败，起因: ${reason_text}，请检查网络或节点状态"
    return 1
}

# =============================================================
# 主入口
# =============================================================
# =============================================================
# 防重入：pidfile 机制
# 仅当锁文件中记录的 PID 仍然存活且确为本程序时，才视为“已有实例在跑”，
# 此时当前进程静默退出（不打断、不强杀任何进程）。
# 若锁文件不存在、PID 已死、或 PID 被复用为其他程序，则正常接管。
# 任何退出路径（正常/报错/信号）都会通过 trap 清理锁文件，避免假死锁。
# =============================================================
PID_FILE="/var/run/network-detector.pid"

is_our_process() {
    local pid="$1"
    [ -z "$pid" ] && return 1
    # PID 必须存活
    kill -0 "$pid" 2>/dev/null || return 1
    # 校验 cmdline 确为本程序，防止 PID 复用误判
    if [ -r "/proc/$pid/cmdline" ]; then
        grep -q "network-detector" "/proc/$pid/cmdline" 2>/dev/null || return 1
    fi
    return 0
}

main() {
    # 防重入检查：已有实例在跑则直接退出，避免进程堆积与误杀
    if [ -f "$PID_FILE" ]; then
        local oldpid=$(cat "$PID_FILE" 2>/dev/null | tr -d ' \t')
        if is_our_process "$oldpid"; then
            logger -t "network-detector" "已有实例在运行 (PID: $oldpid)，本次跳过"
            log "已有实例在运行 (PID: ${oldpid})，本次跳过"
            exit 0
        fi
        # 锁文件残留（进程已死或非本程序），清理后接管
        rm -f "$PID_FILE" 2>/dev/null
    fi

    # 写入自身 PID。锁文件不在 EXIT trap 中删除：
    # busybox ash 在子 shell 结束时也会触发 EXIT trap，会把仍在运行的进程的锁删掉，
    # 导致两轮检测并发执行、互相抢着切换节点。锁只由下一轮按 PID 存活检测来清理。
    echo $$ > "$PID_FILE"
    trap 'rm -f "$API_TMP" "$TEST_TMP" "$CAND_FILE" 2>/dev/null' EXIT INT TERM

    load_global_config

    # 检查 Clash API 是否配置
    if [ -z "$CLASH_API" ]; then
        logger -t "network-detector" "Clash API 未配置，退出"
        exit 1
    fi

    cleanup_old_logs
    log "========== 开始检测 =========="

    local task_idx=0
    local task_count=0
    local fail_count=0

    while uci -q get "network-detector.@task[$task_idx]" > /dev/null 2>&1; do
        local enabled=$(uci -q get "network-detector.@task[$task_idx].enabled" 2>/dev/null)
        if [ "$enabled" = "1" ]; then
            local TASK_NAME=$(uci -q get "network-detector.@task[$task_idx].name" 2>/dev/null)
            local TASK_PROXY_GROUP=$(uci -q get "network-detector.@task[$task_idx].proxy_group" 2>/dev/null)
            local TASK_TEST_URL=$(uci -q get "network-detector.@task[$task_idx].test_url" 2>/dev/null)
            local TASK_BANNED_KEYWORD=$(uci -q get "network-detector.@task[$task_idx].banned_keyword" 2>/dev/null)
            local TASK_MAX_TRIES=$(uci -q get "network-detector.@task[$task_idx].max_tries" 2>/dev/null)

            [ -z "$TASK_MAX_TRIES" ] && TASK_MAX_TRIES="5"
            case "$TASK_MAX_TRIES" in *[!0-9]*) TASK_MAX_TRIES="5" ;; esac
            [ "$TASK_MAX_TRIES" -lt 1 ] && TASK_MAX_TRIES="1"
            [ "$TASK_MAX_TRIES" -gt 20 ] && TASK_MAX_TRIES="20"

            task_count=$((task_count + 1))
            run_single_task "$TASK_NAME" "$TASK_PROXY_GROUP" "$TASK_TEST_URL" "$TASK_BANNED_KEYWORD" "$TASK_MAX_TRIES" || fail_count=$((fail_count + 1))
        fi
        task_idx=$((task_idx + 1))
    done

    log "========== 本轮检测结束 (任务:${task_count}, 失败:${fail_count}) =========="
}

main "$@"
