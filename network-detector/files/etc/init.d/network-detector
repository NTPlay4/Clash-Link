#!/bin/sh /etc/rc.common
# ========================================
# network-detector procd 调度服务
# 顺序调度：启动即检测一轮，本轮结束后再等待下一轮
# ========================================

START=99
USE_PROCD=1

PROG="/usr/bin/network-detector"
CRON_MARKER="# --- network-detector ---"

service_triggers() {
    procd_add_reload_trigger "network-detector"
}

# 迁移：清掉旧版本遗留的 cron 条目（新版本不再使用 cron）
remove_legacy_cron() {
    if [ -f /etc/crontabs/root ] && grep -Fq "$CRON_MARKER" /etc/crontabs/root; then
        sed -i "/${CRON_MARKER}/d" /etc/crontabs/root
        /etc/init.d/cron restart 2>/dev/null
    fi
}

start_service() {
    local enabled=$(uci -q get network-detector.@main[0].enabled 2>/dev/null)
    if [ "$enabled" = "0" ]; then
        echo "network-detector 已被禁用，跳过启动"
        return 0
    fi

    local has_task=0
    local idx=0
    while uci -q get "network-detector.@task[$idx]" > /dev/null 2>&1; do
        local ten=$(uci -q get "network-detector.@task[$idx].enabled" 2>/dev/null)
        if [ "$ten" = "1" ]; then
            has_task=1
            break
        fi
        idx=$((idx + 1))
    done

    if [ "$has_task" = "0" ]; then
        echo "network-detector: 无启用的检测任务，跳过启动 请在 LuCI 中至少添加一个检测任务"
        return 0
    fi

    remove_legacy_cron
    [ -x "$PROG" ] || return 0

    # 由 procd 托管调度器进程：服务启动即运行一轮，结束后按间隔计时；
    # 服务停止/禁用时 procd 直接终止进程，定时器随服务一起停止
    procd_open_instance
    procd_set_param command "$PROG" --loop
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    remove_legacy_cron
    rm -f /var/run/network-detector.trigger 2>/dev/null
    rm -f /var/run/network-detector.scheduler.pid 2>/dev/null
    echo "network-detector 已停止"
}

reload_service() {
    stop
    start
}
